# .env.example — copy to .env; never commit your populated environment file.
# OPENAI_API_KEY is read only from this project's .env file; system values are ignored.
# Enter the literal key here (no ${VARIABLE} substitution), then restart the backend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Set production and a strong password before exposing this shared workspace publicly.
APP_ENV=development
ACCESS_PASSWORD=
COOKIE_SECURE=false
# Comma-separated exact HTTPS origins when a trusted reverse proxy changes the origin.
ALLOWED_ORIGINS=

# Conservative per-session limits apply to planning, retries, browsing, and synthesis.
MAX_STEPS=18
MAX_RUNTIME_SECONDS=240
MAX_CONCURRENT_SESSIONS=2
MAX_SESSION_TOKENS=60000
MAX_MODEL_CALLS=32
API_TIMEOUT_SECONDS=35
# Public search fallback order; providers that deny access are skipped for that research run.
SEARCH_PROVIDERS=bing,duckduckgo,google

# Docker Compose overrides these paths to the mounted persistent volume and built frontend.
DATA_DIR=data
FRONTEND_DIR=frontend/dist
